# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
# Optional: use custom base URL for local Claude or custom endpoint
ANTHROPIC_BASE_URL=

# Claude model (defaults to claude-sonnet-4-6 if not set)
CLAUDE_MODEL=claude-sonnet-4-6

# Granola API credentials (from Granola desktop app)
GRANOLA_SUPABASE_PATH=~/Library/Application Support/Granola/supabase.json

# Obsidian vault path (local machine)
OBSIDIAN_VAULT_PATH=~/Obsidian Vault

# Google Drive rclone config
RCLONE_DEST=gdrive:Granola Notes

# Pipeline schedule (cron format, defaults to hourly)
CRON_SCHEDULE=0 * * * *

# Lookback window for new meetings (days)
LOOKBACK_DAYS=7
