# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...
# Optional: use custom base URL for local Claude or custom endpoint
ANTHROPIC_BASE_URL=

# Claude model (defaults to bedrock.claude-sonnet-4-6 if not set)
CLAUDE_MODEL=bedrock.claude-sonnet-4-6

# Granola auth — stored-accounts.json is preferred (desktop app keeps it fresh)
GRANOLA_AUTH_PATH=~/Library/Application Support/Granola/stored-accounts.json
# Fallback: supabase.json (older format, less reliably refreshed)
GRANOLA_SUPABASE_PATH=~/Library/Application Support/Granola/supabase.json

# Obsidian vault path (local machine)
OBSIDIAN_VAULT_PATH=~/Obsidian Vault

# Google Drive rclone config
RCLONE_DEST=gdrive:Granola Notes

# Pipeline schedule (cron format, defaults to hourly)
CRON_SCHEDULE=0 * * * *

# Lookback window for new meetings (days)
LOOKBACK_DAYS=30

# Optional: folder input mode (set to enable; disables Granola API for ingestion)
# Drop .md files here and they'll be processed on next cron tick
# WATCH_FOLDER=./watch
