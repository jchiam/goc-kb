    "ingest": "tsx --env-file ../.env src/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
